diff --git a/dlls/winexinput.sys/main.c b/dlls/winexinput.sys/main.c
index e79bb31..6d88ef4 100644
--- a/dlls/winexinput.sys/main.c
+++ b/dlls/winexinput.sys/main.c
@@ -160,6 +160,10 @@ struct func_device
     HIDP_VALUE_CAPS rt_caps;
     HIDP_DEVICE_DESC device_desc;
 
+    BOOL xbox_bt_layout;
+    BOOL xbox_bt_gap_buttons;
+    BOOL xbox_bt_ac_back;
+
     /* everything below requires holding the cs */
     CRITICAL_SECTION cs;
     ULONG report_len;
@@ -195,12 +199,63 @@ static void translate_report_to_xinput_state(struct func_device *fdo)
 {
     ULONG lx = 0, ly = 0, rx = 0, ry = 0, lt = 0, rt = 0, hat = 0;
     PHIDP_PREPARSED_DATA preparsed;
-    USAGE usages[10];
+    USAGE usages[32];
     NTSTATUS status;
     ULONG i, count;
+    static const BYTE gap_map[16] = {0, 1, 2, 0, 3, 4, 0, 5, 6, 0, 0, 7, 8, 0, 9, 10};
 
     preparsed = fdo->device_desc.CollectionDesc->PreparsedData;
 
+    if (fdo->xbox_bt_layout)
+    {
+        ULONG back = 0;
+        count = ARRAY_SIZE(usages);
+        status = HidP_GetUsages(HidP_Input, HID_USAGE_PAGE_BUTTON, 0, usages,
+                                &count, preparsed, fdo->report_buf, fdo->report_len);
+        if (status != HIDP_STATUS_SUCCESS) { WARN("HidP_GetUsages returned %#lx\n", status); count = 0; }
+        HidP_GetUsageValue(HidP_Input, HID_USAGE_PAGE_GENERIC, 0, HID_USAGE_GENERIC_HATSWITCH,
+                           &hat, preparsed, fdo->report_buf, fdo->report_len);
+        HidP_GetUsageValue(HidP_Input, HID_USAGE_PAGE_GENERIC, 0, HID_USAGE_GENERIC_X,
+                           &lx, preparsed, fdo->report_buf, fdo->report_len);
+        HidP_GetUsageValue(HidP_Input, HID_USAGE_PAGE_GENERIC, 0, HID_USAGE_GENERIC_Y,
+                           &ly, preparsed, fdo->report_buf, fdo->report_len);
+        HidP_GetUsageValue(HidP_Input, HID_USAGE_PAGE_GENERIC, 0, HID_USAGE_GENERIC_Z,
+                           &rx, preparsed, fdo->report_buf, fdo->report_len);
+        HidP_GetUsageValue(HidP_Input, HID_USAGE_PAGE_GENERIC, 0, HID_USAGE_GENERIC_RZ,
+                           &ry, preparsed, fdo->report_buf, fdo->report_len);
+        HidP_GetUsageValue(HidP_Input, HID_USAGE_PAGE_SIMULATION, 0, HID_USAGE_SIMULATION_BRAKE,
+                           &lt, preparsed, fdo->report_buf, fdo->report_len);
+        HidP_GetUsageValue(HidP_Input, HID_USAGE_PAGE_SIMULATION, 0, HID_USAGE_SIMULATION_ACCELERATOR,
+                           &rt, preparsed, fdo->report_buf, fdo->report_len);
+
+        if (hat < 1 || hat > 8) fdo->xinput_state.buttons = 0;
+        else fdo->xinput_state.buttons = hat << 10;
+        for (i = 0; i < count; i++)
+        {
+            UINT b = usages[i];
+            if (fdo->xbox_bt_gap_buttons) b = b < ARRAY_SIZE(gap_map) ? gap_map[b] : 0;
+            if (b < 1 || b > 10) continue;
+            fdo->xinput_state.buttons |= (1 << (b - 1));
+        }
+        if (fdo->xbox_bt_ac_back)
+        {
+            USAGE cusages[8];
+            ULONG ccount = ARRAY_SIZE(cusages);
+            if (HidP_GetUsages(HidP_Input, HID_USAGE_PAGE_CONSUMER, 0, cusages, &ccount, preparsed,
+                               fdo->report_buf, fdo->report_len) != HIDP_STATUS_SUCCESS) ccount = 0;
+            for (i = 0; i < ccount; i++) if (cusages[i] == 0x224) back = 1;
+            if (back) fdo->xinput_state.buttons |= (1 << 6);
+        }
+        fdo->xinput_state.lx_axis = scale_value(lx, &fdo->lx_caps, 0, 65535);
+        fdo->xinput_state.ly_axis = scale_value(ly, &fdo->ly_caps, 0, 65535);
+        fdo->xinput_state.rx_axis = scale_value(rx, &fdo->rx_caps, 0, 65535);
+        fdo->xinput_state.ry_axis = scale_value(ry, &fdo->ry_caps, 0, 65535);
+        rt = scale_value(rt, &fdo->rt_caps, 0, 255);
+        lt = scale_value(lt, &fdo->lt_caps, 0, 255);
+        fdo->xinput_state.trigger = 0x8000 + (lt - rt) * 128;
+        return;
+    }
+
     count = ARRAY_SIZE(usages);
     status = HidP_GetUsages(HidP_Input, HID_USAGE_PAGE_BUTTON, 0, usages,
                             &count, preparsed, fdo->report_buf, fdo->report_len);
@@ -697,6 +752,37 @@ static NTSTATUS initialize_device(DEVICE_OBJECT *device)
         if (!caps->IsRange) check_value_caps(fdo, caps->NotRange.Usage, caps);
         else for (u = caps->Range.UsageMin; u <=caps->Range.UsageMax; u++) check_value_caps(fdo, u, value_caps + i);
     }
+    if (status == HIDP_STATUS_SUCCESS && !fdo->rx_caps.UsagePage && !fdo->ry_caps.UsagePage)
+    {
+        HIDP_VALUE_CAPS z = fdo->lt_caps, rz = fdo->rt_caps, brake = {0}, accel = {0};
+        for (i = 0; i < caps.NumberInputValueCaps; i++)
+        {
+            HIDP_VALUE_CAPS *vc = value_caps + i;
+            if (vc->UsagePage != HID_USAGE_PAGE_SIMULATION || vc->IsRange) continue;
+            if (vc->NotRange.Usage == HID_USAGE_SIMULATION_BRAKE) brake = *vc;
+            if (vc->NotRange.Usage == HID_USAGE_SIMULATION_ACCELERATOR) accel = *vc;
+        }
+        if (z.UsagePage && rz.UsagePage && brake.UsagePage && accel.UsagePage)
+        {
+            fdo->xbox_bt_layout = TRUE;
+            fdo->rx_caps = z;
+            fdo->ry_caps = rz;
+            fdo->lt_caps = brake;
+            fdo->rt_caps = accel;
+            fdo->xbox_bt_gap_buttons = button_count >= 15;
+            if (!(button_caps = malloc(sizeof(*button_caps) * caps.NumberInputButtonCaps))) { free(value_caps); return STATUS_NO_MEMORY; }
+            if (HidP_GetButtonCaps(HidP_Input, button_caps, &caps.NumberInputButtonCaps, preparsed) != HIDP_STATUS_SUCCESS)
+                caps.NumberInputButtonCaps = 0;
+            for (i = 0; i < caps.NumberInputButtonCaps; i++)
+            {
+                if (button_caps[i].UsagePage != HID_USAGE_PAGE_CONSUMER) continue;
+                if (button_caps[i].IsRange ? (button_caps[i].Range.UsageMin <= 0x224 && button_caps[i].Range.UsageMax >= 0x224)
+                                           : button_caps[i].NotRange.Usage == 0x224) fdo->xbox_bt_ac_back = TRUE;
+            }
+            free(button_caps);
+            TRACE("using Xbox Bluetooth layout, gap buttons %u, AC Back %u\n", fdo->xbox_bt_gap_buttons, fdo->xbox_bt_ac_back);
+        }
+    }
     free(value_caps);
     if (status != HIDP_STATUS_SUCCESS) return status;
     if (!fdo->lx_caps.UsagePage) WARN("missing lx axis\n");
